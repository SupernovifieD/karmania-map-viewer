#!/usr/bin/env bash
# Writes crates/karmania-crs/src/registry/table.rs: the definitions of the `crs-definitions` crate as
# a table of its constants, in the order of their codes.
#
# The crate finds a definition with one match of thousands of arms, `from_code`. Compiled to
# WebAssembly that is one function so large that V8 (Node 24, and Chromium) runs out of memory when it
# tries to optimise it after a few dozen calls, and the process aborts (see step 12.F7 in
# docs/decisions.md). The table is plain data, looked up by binary search, and `from_code` is never
# called outside the test that checks the table against it.
#
#   scripts/generate-crs-table     write the table again (run it after changing the version of the crate)
#
# The test `registry::tests::the_table_is_what_from_code_says_for_every_code` fails if the table is
# out of date, and the Rust job of CI runs this script and fails if the file it writes differs from the
# one in the repository.
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$root"

version="$(cargo pkgid crs-definitions | sed 's/.*@//')"
source="$(ls -d "${CARGO_HOME:-$HOME/.cargo}"/registry/src/*/crs-definitions-"$version" | head -1)"
if [[ -z "$source" || ! -f "$source/src/from_code.rs" ]]; then
  echo "The source of crs-definitions $version is not in the cargo registry; run 'cargo fetch' first." >&2
  exit 1
fi

out="crates/karmania-crs/src/registry/table.rs"
mkdir -p "$(dirname "$out")"
{
  echo "// @generated by scripts/generate-crs-table from crs-definitions $version. Do not edit by hand."
  echo "//"
  echo "// The definitions as data, in the order of their codes: see that script for why."
  echo "#![allow(clippy::unreadable_literal)]"
  echo
  echo "use crs_definitions::{Def, *};"
  echo
  echo "pub(super) static DEFINITIONS: &[Def] = &["
  sed -n 's/^ *\([0-9][0-9]*\) => \(EPSG_[A-Za-z0-9_]*\),$/\1 \2/p' "$source/src/from_code.rs" \
    | sort -n -u | awk '{ printf "    %s,\n", $2 }'
  echo "];"
} > "$out"
# Formatted as `cargo fmt --check` (a step of `pnpm check` and of CI) wants it: rustfmt puts several
# entries on a line, so the file is a sixth the length it is written in.
# Only this file is formatted, with the edition of the workspace (rustfmt finds rustfmt.toml itself).
edition="$(sed -n 's/^edition *= *"\([0-9]*\)".*/\1/p' Cargo.toml | head -1)"
rustfmt --edition "$edition" "$out"
count="$(grep -o 'EPSG_[A-Za-z0-9_]*' "$out" | wc -l | tr -d ' ')"
echo "Wrote $out: $count definitions from crs-definitions $version."
