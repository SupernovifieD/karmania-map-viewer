#!/usr/bin/env bash
# Builds the WebAssembly kernel into packages/engine/wasm (not committed), where the
# engine imports it from.
#
# Needs wasm-pack (cargo install wasm-pack) and the wasm32-unknown-unknown target,
# which rust-toolchain.toml installs. Pass --dev for a faster, unoptimised build.
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
profile="--release"
if [[ "${1:-}" == "--dev" ]]; then
  profile="--dev"
fi

if ! command -v wasm-pack >/dev/null 2>&1; then
  echo "wasm-pack is not installed. Install it with: cargo install wasm-pack" >&2
  exit 1
fi

cd "$root"
# --target web gives an ES module that a module Web Worker can load.
# The output directory is relative to the crate. --no-pack skips the package.json that
# wasm-pack would write: the engine package is the one that owns these files.
wasm-pack build crates/karmania-wasm --target web "$profile" --no-pack \
  --out-dir ../../packages/engine/wasm --out-name karmania_wasm
