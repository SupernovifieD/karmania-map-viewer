{
  "name": "@karmania/app",
  "version": "0.0.0",
  "private": true,
  "description": "Karmania app: the standalone application, and the gallery that shows its components",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:axe": "KARMANIA_AXE=1 playwright test --project accessibility",
    "test:perf": "KARMANIA_PERF=1 playwright test --project performance --workers=1"
  },
  "dependencies": {
    "@karmania/engine": "workspace:*",
    "@karmania/ui": "workspace:*",
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
